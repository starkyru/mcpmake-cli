"""{{serverName}} MCP Server — generated by mcpmake."""

import os
import json
import httpx
from urllib.parse import quote
from dotenv import load_dotenv
from mcp.server import Server
from mcp.server.stdio import stdio_server
from mcp.types import TextContent

load_dotenv()

def _resolve_base_url() -> str:
    # MCP_ENVIRONMENTS is a JSON name->URL map; API_ENVIRONMENT selects one.
    # Falls back to BASE_URL when either is unset, malformed, or the name is unknown.
    raw = os.environ.get("MCP_ENVIRONMENTS")
    selected = os.environ.get("API_ENVIRONMENT")
    if raw and selected:
        try:
            envs = json.loads(raw)
            url = envs.get(selected)
            if isinstance(url, str) and url:
                return url.rstrip("/")
        except (ValueError, AttributeError):
            pass
    return os.environ.get("BASE_URL", "{{{baseUrl}}}").rstrip("/")


BASE_URL = _resolve_base_url()
{{#each authSchemes}}
{{#if (eq type "http-bearer")}}
BEARER_TOKEN = os.environ.get("{{envVarName}}", "")
{{/if}}
{{#if (eq type "apiKey")}}
API_KEY = os.environ.get("{{envVarName}}", "")
{{/if}}
{{/each}}

server = Server("{{serverName}}")
client = httpx.AsyncClient(timeout=30.0)


def _headers() -> dict[str, str]:
    headers: dict[str, str] = {}
{{#each authSchemes}}
{{#if (eq type "http-bearer")}}
    if BEARER_TOKEN:
        headers["Authorization"] = f"Bearer {BEARER_TOKEN}"
{{/if}}
{{#if (eq type "apiKey")}}
    if API_KEY:
        headers["{{headerName}}"] = API_KEY
{{/if}}
{{/each}}
    return headers


{{#each tools}}
@server.tool()
async def {{functionName}}({{#each pyPathParams}}{{pyName}}: str, {{/each}}{{#each pyQueryParams}}{{pyName}}: str = "", {{/each}}{{#if hasRequestBody}}body: dict | None = None{{/if}}) -> list[TextContent]:
    """{{pyDocstring description}}"""
    url = BASE_URL + "{{pyStr pathTemplate}}"
    {{#each pyPathParams}}
    url = url.replace("{{pyStr brace}}", quote(str({{pyName}}), safe=""))
    {{/each}}
    {{#if pyQueryParams.length}}
    params = { {{#each pyQueryParams}}"{{pyStr apiName}}": {{pyName}}, {{/each}} }
    params = {k: v for k, v in params.items() if v}
    {{/if}}
    try:
        resp = await client.request(
            "{{method}}",
            url,
            headers=_headers(),
            {{#if queryParams.length}}
            params=params,
            {{/if}}
            {{#if hasRequestBody}}
            json=body,
            {{/if}}
        )
        data = resp.json() if resp.headers.get("content-type", "").startswith("application/json") else resp.text
        return [TextContent(type="text", text=json.dumps(data, indent=2) if isinstance(data, (dict, list)) else str(data))]
    except Exception as e:
        return [TextContent(type="text", text=f"Error: {e}")]


{{/each}}
async def main():
    async with stdio_server() as (read_stream, write_stream):
        await server.run(read_stream, write_stream, server.create_initialization_options())


if __name__ == "__main__":
    import asyncio
    asyncio.run(main())
