def _resolve_base_url() -> str:
    # MCP_ENVIRONMENTS is a JSON name->URL map; API_ENVIRONMENT selects one.
    # Falls back to BASE_URL when either is unset, malformed, or the name is unknown.
    raw = os.environ.get("MCP_ENVIRONMENTS")
    selected = os.environ.get("API_ENVIRONMENT")
    if raw and selected:
        try:
            envs = json.loads(raw)
            url = envs.get(selected)
            if isinstance(url, str) and url:
                return url.rstrip("/")
        except (ValueError, AttributeError):
            pass
    return os.environ.get("BASE_URL", "{{{baseUrl}}}").rstrip("/")


BASE_URL = _resolve_base_url()
{{#each authSchemes}}
{{#if (eq type "http-bearer")}}
BEARER_TOKEN = os.environ.get("{{envVarName}}", "")
{{/if}}
{{#if (eq type "apiKey")}}
API_KEY = os.environ.get("{{envVarName}}", "")
{{/if}}
{{/each}}

server = FastMCP("{{serverName}}")

# Hard per-request deadline (seconds) and response-size cap (bytes). A stalled or
# runaway upstream otherwise keeps tool calls alive indefinitely or exhausts memory.
try:
    _timeout_ms = float(os.environ.get("MCP_REQUEST_TIMEOUT_MS", "30000"))
    _REQUEST_TIMEOUT_S = _timeout_ms / 1000.0 if _timeout_ms > 0 else 30.0
except (ValueError, TypeError):
    _REQUEST_TIMEOUT_S = 30.0
try:
    _max_bytes = int(os.environ.get("MCP_MAX_RESPONSE_BYTES", str(10 * 1024 * 1024)))
    _MAX_RESPONSE_BYTES = _max_bytes if _max_bytes > 0 else 10 * 1024 * 1024
except (ValueError, TypeError):
    _MAX_RESPONSE_BYTES = 10 * 1024 * 1024
client = httpx.AsyncClient(timeout=_REQUEST_TIMEOUT_S)


def _headers() -> dict[str, str]:
    headers: dict[str, str] = {}
{{#each authSchemes}}
{{#if (eq type "http-bearer")}}
    if BEARER_TOKEN:
        headers["Authorization"] = f"Bearer {BEARER_TOKEN}"
{{/if}}
{{#if (eq type "apiKey")}}
{{#if (eq in "header")}}
    if API_KEY:
        headers["{{pyStr headerName}}"] = API_KEY
{{/if}}
{{#if (eq in "cookie")}}
    # API key sent as a cookie — appended to the Cookie header.
    if API_KEY:
        _existing = headers.get("Cookie")
        _pair = "{{pyStr headerName}}=" + quote(str(API_KEY), safe="")
        headers["Cookie"] = (_existing + "; " + _pair) if _existing else _pair
{{/if}}
{{/if}}
{{/each}}
    return headers


def _auth_query_params() -> dict[str, str]:
    # apiKey-in-query auth: the key is sent as a query parameter, not a header.
    params: dict[str, str] = {}
{{#each authSchemes}}
{{#if (eq type "apiKey")}}
{{#if (eq in "query")}}
    if API_KEY:
        params["{{pyStr headerName}}"] = API_KEY
{{/if}}
{{/if}}
{{/each}}
    return params


