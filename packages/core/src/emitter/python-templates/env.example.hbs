# {{serverName}} configuration
BASE_URL={{{baseUrl}}}
{{#if environmentsJson}}
# Named environments. MCP_ENVIRONMENTS is a JSON name→URL map; API_ENVIRONMENT
# selects one. Falls back to BASE_URL when unset or the name is unknown.
MCP_ENVIRONMENTS={{environmentsJson}}
API_ENVIRONMENT={{defaultEnvironment}}
{{/if}}
{{#each authEnvVars}}
# {{description}}
{{name}}=
{{/each}}
