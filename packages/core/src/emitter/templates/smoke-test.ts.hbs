import { describe, it, expect } from 'vitest';

/**
 * Functional smoke suite generated by `mcpmake test-scaffold` from your OpenAPI
 * spec. It exercises every read-only operation against a REAL API and asserts
 * the response status + top-level shape — catching live drift the unit tests
 * (which never touch the network) cannot.
 *
 * Runs only when SMOKE_BASE_URL is set (it falls back to the spec's base URL);
 * otherwise every case is skipped, so it is CI-safe by default. Provide the same
 * auth env vars your generated server uses (BEARER_TOKEN / API_KEY / ...).
 *
 * Read-only by design: it never issues write requests. Edit freely — it's yours.
 */

const SUITE_NAME = {{{serverNameJson}}};
const BASE_URL = process.env.SMOKE_BASE_URL || {{{baseUrlJson}}};
const CASES = {{{suiteJson}}} as const;
const AUTH = {{{authJson}}} as const;
const CHAIN = {{{chainJson}}} as const;

type Case = (typeof CASES)[number];

function authHeaders(): Record<string, string> {
  const h: Record<string, string> = { accept: 'application/json' };
  for (const s of AUTH) {
    if (s.type === 'http-bearer') {
      const v = process.env[s.envVarName];
      if (v) h['authorization'] = 'Bearer ' + v;
    } else if (s.type === 'oauth2') {
      const v = process.env.OAUTH2_TOKEN;
      if (v) h['authorization'] = 'Bearer ' + v;
    } else if (s.type === 'http-basic') {
      const u = process.env.BASIC_USERNAME;
      const p = process.env.BASIC_PASSWORD;
      if (u && p) h['authorization'] = 'Basic ' + Buffer.from(u + ':' + p).toString('base64');
    } else if (s.type === 'apiKey' && s.in === 'header' && s.headerName) {
      const v = process.env[s.envVarName];
      if (v) h[s.headerName] = v;
    }
  }
  return h;
}

function buildUrl(path: string, query: Record<string, string>): string {
  const u = new URL(path.replace(/^\//, ''), BASE_URL.endsWith('/') ? BASE_URL : BASE_URL + '/');
  for (const s of AUTH) {
    if (s.type === 'apiKey' && s.in === 'query' && s.headerName) {
      const v = process.env[s.envVarName];
      if (v) u.searchParams.set(s.headerName, v);
    }
  }
  for (const key of Object.keys(query)) u.searchParams.set(key, query[key]);
  return u.toString();
}

async function expect2xx(res: Response, label: string): Promise<void> {
  expect(res.status, label + ' -> ' + res.status).toBeGreaterThanOrEqual(200);
  expect(res.status, label + ' -> ' + res.status).toBeLessThan(300);
}

// CI-safe gate: the suite only hits the network when you explicitly set
// SMOKE_BASE_URL. Unset -> every case is skipped (BASE_URL above is only the
// default target to use once you opt in). Flip to `BASE_URL ? ...` if you want
// it to run against the baked default automatically.
const run = process.env.SMOKE_BASE_URL ? describe : describe.skip;

run(SUITE_NAME + ' — functional smoke', () => {
  for (const c of CASES as readonly Case[]) {
    it(c.method + ' ' + c.path + ' (' + c.name + ')', async () => {
      const res = await fetch(buildUrl(c.path, c.query), { method: c.method, headers: authHeaders() });
      await expect2xx(res, c.method + ' ' + c.path);
      if (c.method === 'HEAD') return;
      const body: unknown = await res.json();
      if (c.bodyKind === 'array') {
        expect(Array.isArray(body), c.path + ' should return an array').toBe(true);
      } else if (c.bodyKind === 'object') {
        for (const field of c.requiredFields) {
          expect(body as Record<string, unknown>, 'missing required field: ' + field).toHaveProperty(field);
        }
      }
    });
  }

{{#if hasChain}}
  it(
    'chains ' + CHAIN.listName + ' -> ' + CHAIN.itemName + ' (response data across steps)',
    async () => {
      const listRes = await fetch(buildUrl(CHAIN.listPath, {}), { headers: authHeaders() });
      await expect2xx(listRes, CHAIN.listName);
      const list: unknown = await listRes.json();
      const items = Array.isArray(list)
        ? list
        : Array.isArray((list as { data?: unknown[] })?.data)
          ? (list as { data: unknown[] }).data
          : [];
      const first = items[0] as Record<string, unknown> | undefined;
      if (first == null) return; // empty collection — nothing to chain
      const id = first.id ?? first[CHAIN.idParam];
      expect(id, 'first list element has no id to chain from').not.toBeUndefined();
      const itemPath = CHAIN.itemPathTemplate.replace(
        '{' + CHAIN.idParam + '}',
        encodeURIComponent(String(id)),
      );
      const itemRes = await fetch(buildUrl(itemPath, {}), { headers: authHeaders() });
      await expect2xx(itemRes, CHAIN.itemName + ' for id=' + String(id));
    },
  );
{{/if}}
});
