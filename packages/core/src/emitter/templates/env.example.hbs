# {{serverName}} configuration

# Base URL for the API
BASE_URL={{baseUrl}}

# Named environments (optional). MCP_ENVIRONMENTS is a JSON object mapping a
# name to a base URL; API_ENVIRONMENT selects one. Falls back to BASE_URL when
# unset or the name is unknown.
{{#if environmentsJson}}
MCP_ENVIRONMENTS={{environmentsJson}}
API_ENVIRONMENT={{defaultEnvironment}}
{{else}}
# MCP_ENVIRONMENTS={"production":"{{baseUrl}}","sandbox":"https://sandbox.example.com"}
# API_ENVIRONMENT=production
{{/if}}

{{#each authEnvVars}}
# {{description}}
{{name}}=
{{/each}}

# HTTP tuning
MAX_RETRIES=3
REQUEST_INTERVAL_MS=100

# Runtime tool filtering (optional). Comma-separated tool names.
# MCP_TOOLS — allowlist: only these tools are registered.
# MCP_EXCLUDE_TOOLS — denylist: these tools are never registered (applied after the allowlist).
# MCP_TOOLS=
# MCP_EXCLUDE_TOOLS=

# Custom default headers added to every upstream request (optional, JSON object).
# MCP_DEFAULT_HEADERS={"X-Tenant-Id":"acme","X-Trace":"1"}

# Auto-generate an Idempotency-Key header for mutating (POST/PUT/PATCH/DELETE)
# requests when no per-call idempotency_key is supplied (optional).
# MCP_IDEMPOTENCY_AUTO=true
{{#if (eq transport "http")}}

# Transport: "stdio" or "http"
TRANSPORT=http
PORT=3000
# Allowed origin for CORS/DNS-rebinding protection (leave empty to allow all in dev)
ALLOWED_ORIGIN=
# Bearer token required on every /mcp request. When set, clients must send
# `Authorization: Bearer <token>`. Leave empty to disable auth (local/dev only).
MCP_AUTH_TOKEN=
# Session mode (MCP 2026-07-28): leave empty for stateless (default, recommended
# — any request can hit any instance). Set to "true" for stateful per-session
# (Mcp-Session-Id) mode if a client needs resumable streams.
MCP_STATEFUL=
{{/if}}
