export interface AppConfig {
  baseUrl: string;
{{#each authSchemes}}
{{#if (eq type "apiKey")}}
{{#unless (eq emitApiKeyValue false)}}
  apiKey?: string;
{{/unless}}
{{#if (eq in "query")}}
  /** Query-parameter name the API key is appended under (apiKey-in-query auth). */
  apiKeyQueryName?: string;
{{/if}}
{{/if}}
{{#if (eq type "http-bearer")}}
  bearerToken?: string;
{{/if}}
{{#if (eq type "http-basic")}}
  basicUsername?: string;
  basicPassword?: string;
{{/if}}
{{#if (eq type "oauth2")}}
  oauth2Token?: string;
  oauth2ClientId?: string;
  oauth2ClientSecret?: string;
  oauth2AuthorizationUrl?: string;
  oauth2TokenUrl?: string;
  oauth2RedirectUri?: string;
  /** OAuth scopes requested on token grants. Defaults to the spec-declared
   * scopes; override at runtime with OAUTH2_SCOPES (space-separated). */
  oauth2Scopes: string[];
{{/if}}
{{/each}}
  maxRetries: number;
  requestIntervalMs: number;
  /** Extra headers added to every upstream request (non-breaking; empty by default). */
  defaultHeaders: Record<string, string>;
}

/**
 * Resolve the upstream base URL with optional named environments.
 *
 * `MCP_ENVIRONMENTS` is a JSON object mapping an environment name to a base URL,
 * e.g. `{"production":"https://api.example.com","sandbox":"https://sandbox.example.com"}`.
 * `API_ENVIRONMENT` selects one of those names. When either is unset (or the
 * name is unknown) the resolver falls back to `BASE_URL`, so existing
 * deployments are unaffected.
 */
function resolveBaseUrl(): string {
  const raw = process.env.MCP_ENVIRONMENTS;
  const selected = process.env.API_ENVIRONMENT;
  if (raw && selected) {
    try {
      const envs = JSON.parse(raw) as Record<string, unknown>;
      const url = envs[selected];
      if (typeof url === 'string' && url) {
        return url.replace(/\/$/, '');
      }
    } catch {
      // Malformed MCP_ENVIRONMENTS — fall through to BASE_URL.
    }
  }
  return requireEnv('BASE_URL').replace(/\/$/, '');
}

/**
 * Parse `MCP_DEFAULT_HEADERS` (a JSON object of header name → value) into a map
 * applied to every upstream request. Invalid JSON or non-string values are
 * ignored so a bad value never breaks the server.
 */
function loadDefaultHeaders(): Record<string, string> {
  const raw = process.env.MCP_DEFAULT_HEADERS;
  if (!raw) return {};
  try {
    const parsed = JSON.parse(raw) as Record<string, unknown>;
    const headers: Record<string, string> = {};
    for (const [key, value] of Object.entries(parsed)) {
      if (typeof value === 'string') headers[key] = value;
    }
    return headers;
  } catch {
    return {};
  }
}

{{#each authSchemes}}
{{#if (eq type "oauth2")}}
/**
 * Resolve the OAuth scopes requested on token grants. Defaults to the
 * spec-declared scopes baked in at generation time; `OAUTH2_SCOPES`
 * (space-separated) overrides them at runtime. Empty/whitespace tokens are
 * dropped so a stray space never sends an empty scope.
 */
function resolveOAuthScopes(): string[] {
  const raw = process.env.OAUTH2_SCOPES;
  if (raw !== undefined) {
    return raw.split(/\s+/).filter((s) => s.length > 0);
  }
  return {{#if scopes}}{{{json scopes}}}{{else}}[]{{/if}};
}

{{/if}}
{{/each}}
const posInt = (v: string | undefined, d: number): number => {
  const n = parseInt(v ?? '', 10);
  return Number.isInteger(n) && n > 0 ? n : d;
};

/** Like posInt but accepts 0 — useful where 0 is a meaningful "disable" value. */
const nonNegInt = (v: string | undefined, d: number): number => {
  const n = parseInt(v ?? '', 10);
  return Number.isInteger(n) && n >= 0 ? n : d;
};

export function loadConfig(): AppConfig {
  return {
    baseUrl: resolveBaseUrl(),
{{#each authSchemes}}
{{#if (eq type "apiKey")}}
{{#unless (eq emitApiKeyValue false)}}
    apiKey: process.env.{{envVarName}},
{{/unless}}
{{#if (eq in "query")}}
    apiKeyQueryName: {{{json headerName}}},
{{/if}}
{{/if}}
{{#if (eq type "http-bearer")}}
    bearerToken: process.env.{{envVarName}},
{{/if}}
{{#if (eq type "http-basic")}}
    basicUsername: process.env.BASIC_USERNAME,
    basicPassword: process.env.BASIC_PASSWORD,
{{/if}}
{{#if (eq type "oauth2")}}
    oauth2Token: process.env.OAUTH2_TOKEN,
    oauth2ClientId: process.env.OAUTH2_CLIENT_ID,
    oauth2ClientSecret: process.env.OAUTH2_CLIENT_SECRET,
    oauth2AuthorizationUrl: process.env.OAUTH2_AUTHORIZATION_URL,
    oauth2TokenUrl: process.env.OAUTH2_TOKEN_URL,
    oauth2RedirectUri: process.env.OAUTH2_REDIRECT_URI,
    oauth2Scopes: resolveOAuthScopes(),
{{/if}}
{{/each}}
    maxRetries: nonNegInt(process.env.MAX_RETRIES, 3),
    requestIntervalMs: nonNegInt(process.env.REQUEST_INTERVAL_MS, 100),
    defaultHeaders: loadDefaultHeaders(),
  };
}

function requireEnv(name: string): string {
  const value = process.env[name];
  if (!value) {
    throw new Error(`Missing required environment variable: ${name}`);
  }
  return value;
}
