  },
  "files": [
    "dist",
    "bin"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@mcpmake/core": "^0.2.5",
    "citty": "^0.1.6",
    "openapi-types": "^12.1.3",
