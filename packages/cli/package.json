{
  "name": "mcpmake",
  "version": "0.2.5",
  "description": "Generate MCP servers from OpenAPI, HAR, Postman, a URL, a website, or a plain-English description.",
  "type": "module",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/starkyru/mcpmake-cli.git",
    "directory": "packages/cli"
  },
  "homepage": "https://mcpmake.dev",
  "bugs": {
    "url": "https://github.com/starkyru/mcpmake-cli/issues"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "openapi",
    "har",
    "postman",
    "code-generation",
    "cli"
  ],
  "bin": {
